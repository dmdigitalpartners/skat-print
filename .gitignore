# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# dev scripts (local tooling)
temporary screenshots/

# media assets — public/assets and public/favicon are tracked (required for Git-based Vercel
# builds); brand_assets is design-source only and unreferenced by the site, kept out of Git
brand_assets/

# Catalogue background pipeline staging/QC (not deployed directly — copied to public/assets after QC)
scripts/output/
__pycache__/
*.pyc
